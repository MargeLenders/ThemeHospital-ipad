+        isTwoFingerPanning = YES;
+    } else if (sender.state == UIGestureRecognizerStateEnded || sender.state == UIGestureRecognizerStateCancelled || sender.state == UIGestureRecognizerStateFailed) {
+        isTwoFingerPanning = NO;
+    }
